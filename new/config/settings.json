{
  "audioPlayer": {
    "defaultVolume": 0.5,
    "autoPlay": false,
    "shuffleMode": false,
    "repeatMode": 0,
    "supportedFormats": ["mp3", "wav", "ogg", "m4a", "flac", "aac"],
    "maxFileSize": 104857600,
    "scanDepth": 3,
    "cacheEnabled": true,
    "crossfade": false,
    "equalizer": {
      "enabled": false,
      "presets": {
        "rock": [3, 2, 1, 0, -1, 0, 1, 2, 3, 3],
        "pop": [1, 2, 3, 2, 0, -1, -1, 1, 2, 3],
        "jazz": [2, 1, 0, 1, 2, 2, 1, 1, 2, 2],
        "classical": [3, 2, 1, 1, 0, 0, 1, 2, 3, 3]
      }
    }
  },
  "ui": {
    "theme": "dark",
    "animations": true,
    "showWaveform": false,
    "compactMode": false,
    "showLyrics": false
  },
  "library": {
    "autoScan": true,
    "scanInterval": 300000,
    "generateThumbnails": true,
    "extractMetadata": true
  }
}
